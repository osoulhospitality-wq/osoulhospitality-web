<form action="/submit.php" method="post" class="project-brief-form quick-enquiry" data-quick-enquiry>
  <input type="hidden" name="form_name" value="facilities_service_proposal">
  <input type="hidden" name="language" value="en">
  <input type="hidden" name="brief_mode" value="quick">
  <label class="honeypot" aria-hidden="true"><span>Leave blank</span><input name="website" tabindex="-1" autocomplete="off"></label>
  <noscript><p>To send your request without JavaScript, email <a href="mailto:info@osoulhospitality.com">info@osoulhospitality.com</a>.</p></noscript>
  <div class="form-grid">
    <label>Name<input name="name" autocomplete="name" maxlength="120" required></label>
    <div>
      <div id="quick-contact-phone">
        <label>Mobile or WhatsApp number<input name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="30" dir="ltr" required></label>
      </div>
      <div id="quick-contact-email" hidden>
        <label>Email<input name="email" type="email" autocomplete="email" maxlength="180" dir="ltr" disabled></label>
      </div>
      <button type="button" class="quick-enquiry-channel" aria-controls="quick-contact-phone quick-contact-email" hidden>Use email instead</button>
    </div>
  </div>
  <label class="quick-enquiry-service">Service needed<select name="requested_support" required><option value="">Select a service</option><option>Technical maintenance</option><option>Housekeeping and site services</option><option>Asset and contract management</option><option>Integrated facilities management</option></select></label>
  <details class="quick-enquiry-details">
    <summary>Add details (optional)</summary>
    <div class="form-grid">
      <label>Organisation<input name="organization" autocomplete="organization" maxlength="180"></label>
      <label>City<input name="city" autocomplete="address-level2" maxlength="120"></label>
      <label>Property type<input name="asset_type" maxlength="120"></label>
    </div>
    <label class="form-wide">Tell us briefly what you need<textarea name="description" rows="3" maxlength="2000"></textarea></label>
  </details>
  <label class="form-consent"><input type="checkbox" name="consent" value="yes" required><span>I agree to the processing of this request as described in the <a href="/en/privacy/">privacy notice</a>.</span></label>
  <button type="submit" class="button">Request a service proposal</button>
  <p class="quick-enquiry-feedback" role="status" aria-live="polite"></p>
  <p>We aim to respond within two business days.</p>
</form>
    