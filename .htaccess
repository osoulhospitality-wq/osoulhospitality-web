Options -Indexes
DirectoryIndex index.html index.php
AddDefaultCharset UTF-8

RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.osoulhospitality\.com$ [NC]
RewriteRule ^ https://osoulhospitality.com%{REQUEST_URI} [R=301,L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://js-eu1.hs-scripts.com https://js-eu1.hs-analytics.net https://js-eu1.hscollectedforms.net https://js-eu1.hs-banner.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com https://region1.google-analytics.com https://avatars.githubusercontent.com https://track-eu1.hubspot.com https://*.hubspot.com; font-src 'self' data:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://api.github.com https://fdkfxlvsluiqrgedokdm.supabase.co https://*.hubspot.com https://*.hscollectedforms.net; form-action 'self' https://github.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType application/pdf "access plus 30 days"
</IfModule>

<FilesMatch "\.(?:html?)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </IfModule>
</FilesMatch>

<FilesMatch "\.(?:css|js|svg|webp|png)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>

<FilesMatch "^site-hostinger-v1[56]\.js$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </IfModule>
</Files>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<FilesMatch "(?i)(package(-lock)?\.json|tsconfig\.json|README|CHANGELOG|\.map|\.sql)$">
  Require all denied
</FilesMatch>

RewriteRule ^scripts/ - [F,L]
RewriteRule ^content/ - [F,L]
RewriteRule ^command-center/enterprise/src/ - [F,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
