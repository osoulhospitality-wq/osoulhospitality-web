Options -Indexes
ServerSignature Off
DirectoryIndex index.html index.php
AddDefaultCharset UTF-8

RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^(?:www\.osoulhospitality|(?:www\.)?osoolhospitality)\.com$ [NC]
RewriteRule ^ https://osoulhospitality.com%{REQUEST_URI} [R=301,L]

# FM release: equivalent destinations only; all other retired articles are gone.
RewriteRule ^insights/13-week-demand-forecast(?:/index\.html|/)?$ - [G,L]
RewriteRule ^en/insights/13-week-demand-forecast(?:/index\.html|/)?$ - [G,L]
