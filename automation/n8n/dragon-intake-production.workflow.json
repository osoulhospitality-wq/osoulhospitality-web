    {
      "parameters": {
        "jsCode": "const event = $json;\nconst issue = event.issue ?? {};\nconst action = String(event.action ?? '').toLowerCase();\nconst labels = Array.isArray(issue.labels)\n  ? issue.labels.map((label) => typeof label === 'string' ? label : label?.name).filter(Boolean)\n  : [];\nconst acceptedActions = new Set(['opened', 'reopened', 'labeled', 'edited']);\nconst terminalOrBusy = ['dragon-processing', 'dragon-completed'];\nconst eligible = acceptedActions.has(action)\n  && issue.state === 'open'\n  && labels.includes('dragon-task')\n  && !labels.some((label) => terminalOrBusy.includes(label));\n\nif (!eligible) return [];\n\nreturn [{\n  json: {\n    action,\n    issueNumber: issue.number,\n    title: issue.title ?? '',\n    body: issue.body ?? '',\n    issueUrl: issue.html_url ?? '',\n    author: issue.user?.login ?? 'unknown',\n    repository: event.repository?.full_name ?? 'osoulhospitality-wq/osoulhospitality-web',\n    owner: event.repository?.owner?.login ?? 'osoulhospitality-wq',\n    repositoryName: event.repository?.name ?? 'osoulhospitality-web',\n    sourceLabels: labels,\n    processingLabels: [...new Set([...labels.filter((label) => !['dragon-completed', 'dragon-failed'].includes(label)), 'dragon-processing'])],\n    executionId: $execution.id,\n    receivedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "0a19342e-2eeb-42e8-b2f6-9de67ce9d548",
