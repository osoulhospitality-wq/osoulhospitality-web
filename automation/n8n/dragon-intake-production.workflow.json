      "parameters": {
        "jsCode": "const source = $json ?? {};\nfunction textFrom(value) {\n  if (typeof value === 'string') return value.trim();\n  if (Array.isArray(value)) return value.map(textFrom).filter(Boolean).join('\\n\\n').trim();\n  if (!value || typeof value !== 'object') return '';\n  for (const key of ['output', 'text', 'content', 'response', 'answer', 'message']) {\n    const candidate = textFrom(value[key]);\n    if (candidate) return candidate;\n  }\n  for (const key of ['messages', 'generations', 'data']) {\n    const candidate = textFrom(value[key]);\n    if (candidate) return candidate;\n  }\n  return '';\n}\nconst delivery = textFrom(source).trim();\nif (!delivery) {\n  throw new Error(`EMPTY_DRAGON_DELIVERY: available keys: ${Object.keys(source).join(', ') || '(none)'}`);\n}\nreturn [{ json: { ...source, delivery, deliveryLength: delivery.length, normalizedAt: new Date().toISOString() } }];"
      },
      "onError": "continueErrorOutput"
    },
