      "parameters": {
        "jsCode": "const ALLOWED_SENDERS = new Set(['osoulhospitality-wq']);\nconst TERMINAL_OR_BUSY = ['dragon-processing', 'dragon-completed', 'dragon-failed'];\n\nconst event = $json.body && typeof $json.body === 'object' ? $json.body : $json;\nconst issue = event.issue ?? {};\nconst action = String(event.action ?? '').toLowerCase();\nconst sender = event.sender?.login ?? 'unknown';\nconst labels = Array.isArray(issue.labels)\n  ? issue.labels.map((l) => (typeof l === 'string' ? l : l?.name)).filter(Boolean)\n  : [];\nconst addedLabelName = event.label?.name ?? null;\nconst repository = event.repository?.full_name ?? `${event.repository?.owner?.login ?? 'unknown'}/${event.repository?.name ?? 'unknown'}`;\nconst issueNumber = issue.number ?? null;\nconst executionId = String($execution.id);\nconst receivedAt = new Date().toISOString();\n\nfunction reject(reason, decision = 'ignored') {\n  return { decision, reason, repository, issueNumber, action, sender, executionId, receivedAt };\n}\n\nif (!issueNumber) return [{ json: reject('no issue number in payload') }];\n\nif (!ALLOWED_SENDERS.has(sender)) {\n  return [{ json: reject(`sender '${sender}' is not in the authorized allowlist`, 'unauthorized') }];\n}\n\nconst hasDragonTask = labels.includes('dragon-task');\nconst hasTerminalOrBusy = labels.some((l) => TERMINAL_OR_BUSY.includes(l));\n\nlet eligible = false;\nlet reason = '';\n\nif (action === 'opened') {\n  eligible = hasDragonTask && issue.state === 'open' && !hasTerminalOrBusy;\n  reason = eligible ? 'opened with dragon-task already present' : 'opened without a clean dragon-task starting state';\n} else if (action === 'labeled') {\n  eligible = addedLabelName === 'dragon-task' && issue.state === 'open' && !hasTerminalOrBusy;\n  reason = eligible\n    ? 'dragon-task was the specific label just added'\n    : `labeled event ignored (added label was '${addedLabelName}', not a fresh dragon-task application)`;\n} else if (action === 'reopened') {\n  eligible = hasDragonTask && issue.state === 'open' && !hasTerminalOrBusy;\n  reason = eligible\n    ? 'reopened with dragon-task present and no residual terminal/busy label (explicit retry state)'\n    : 'reopened without a cleared terminal/busy label — not treated as an explicit retry';\n} else {\n  reason = `action '${action}' is not in the accepted set (opened, labeled, reopened)`;\n}\n\nif (!eligible) {\n  return [{ json: reject(reason, 'ignored') }];\n}\n\n// commandVersion is GitHub's own issue.updated_at at the moment of this event.\n// It is stable across duplicate/redelivered webhooks of the SAME transition\n// (identical payload => identical updated_at) and changes on any later, genuinely\n// new transition (a later explicit retry has a newer updated_at). This makes the\n// idempotency key derivable without our own counter, so there is no separate\n// race condition in computing it.\nconst commandVersion = issue.updated_at;\nconst idempotencyKey = `${repository}#${issueNumber}@${commandVersion}`;\n\nreturn [{\n  json: {\n    decision: 'proceed',\n    reason,\n    repository,\n    owner: event.repository?.owner?.login ?? 'osoulhospitality-wq',\n    repositoryName: event.repository?.name ?? 'osoulhospitality-web',\n    issueNumber,\n    action,\n    sender,\n    title: issue.title ?? '',\n    body: issue.body ?? '',\n    author: issue.user?.login ?? 'unknown',\n    commandVersion,\n    idempotencyKey,\n    executionId,\n    receivedAt,\n  },\n}];"
      }
